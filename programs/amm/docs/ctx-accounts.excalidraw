      "version": 1,
      "versionNonce": 644780075,
      "text": "initialize   ctx.accounts.handle_initialize(fee_bps, ctx.bumps.pool, ctx.bumps.lp_mint)\ndeposit      ctx.accounts.handle_deposit(amount_a, amount_b, min_lp)\nwithdraw     ctx.accounts.handle_withdraw(lp_amount, min_a, min_b)\nswap         ctx.accounts.handle_swap(amount_in, min_amount_out, a_to_b)",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "initialize   ctx.accounts.handle_initialize(fee_bps, ctx.bumps.pool, ctx.bumps.lp_mint)\ndeposit      ctx.accounts.handle_deposit(amount_a, amount_b, min_lp)\nwithdraw     ctx.accounts.handle_withdraw(lp_amount, min_a, min_b)\nswap         ctx.accounts.handle_swap(amount_in, min_amount_out, a_to_b)",
      "lineHeight": 1.25,
      "autoResize": true
    },
