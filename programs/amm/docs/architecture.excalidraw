      "backgroundColor": "transparent",
      "roundness": null,
      "seed": 157622201,
      "version": 1,
      "versionNonce": 159517226,
      "text": "two rules run through all of it",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "two rules run through all of it",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "angle": 0,
