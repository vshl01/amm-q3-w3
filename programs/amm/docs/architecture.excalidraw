      "backgroundColor": "transparent",
      "roundness": null,
      "seed": 193525164,
      "version": 1,
      "versionNonce": 448251369,
      "text": "1.  every intermediate is u128, narrowed back with a checked try_from.\n    two u64 reserves overflow u64 the moment you multiply them.\n\n2.  division floors, and every floor is placed so the dust stays in the vault.\n    k can grow, never shrink - asserted directly in the tests.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.  every intermediate is u128, narrowed back with a checked try_from.\n    two u64 reserves overflow u64 the moment you multiply them.\n\n2.  division floors, and every floor is placed so the dust stays in the vault.\n    k can grow, never shrink - asserted directly in the tests.",
      "lineHeight": 1.25,
      "autoResize": true
    },
